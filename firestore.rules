rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin email definition
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email.lower() == '10.software.services.app@gmail.com';
    }

    // User profile documents (users/{uid})
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Projects and Expenses sub-collections under each user
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Collection group permissions for admin to query across all users if needed
    match /{path=**}/projects/{projectId} {
      allow read, write: if isAdmin();
    }

    match /{path=**}/expenses/{expenseId} {
      allow read, write: if isAdmin();
    }
  }
}
